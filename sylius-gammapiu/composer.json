{
    "name": "gammapiu/sylius-store",
    "type": "project",
    "description": "Sylius Open Source e-commerce store based on gammapiu-polska.pl",
    "keywords": ["sylius", "ecommerce", "symfony", "gammapiu", "hairdressing"],
    "license": "MIT",
    "authors": [
        {
            "name": "Gamma Piu Polska Development Team",
            "email": "biuro@gammapiu-polska.pl"
        }
    ],
    "require": {
        "php": "^8.2 || ^8.3",
        "sylius/sylius": "^1.13 || ^1.14",
        "doctrine/doctrine-bundle": "^2.11",
        "doctrine/orm": "^2.18 || ^3.0",
        "symfony/dotenv": "^6.4 || ^7.0",
        "symfony/flex": "^2.4",
        "symfony/framework-bundle": "^6.4 || ^7.0",
        "symfony/runtime": "^6.4 || ^7.0",
        "symfony/yaml": "^6.4 || ^7.0",
        "symfony/http-client": "^6.4 || ^7.0",
        "bitbag/inpost-plugin": "^2.0",
        "payum/payum": "^0.18"
    },
    "require-dev": {
        "sylius/sylius-fixtures-bundle": "^1.13",
        "symfony/maker-bundle": "^1.55",
        "symfony/stopwatch": "^6.4 || ^7.0",
        "symfony/web-profiler-bundle": "^6.4 || ^7.0"
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true,
            "symfony/flex": true,
            "symfony/runtime": true
        },
        "sort-packages": true
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "scripts": {
        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "assets:install %PUBLIC_DIR%": "symfony-cmd"
        },
        "post-install-cmd": [
            "@auto-scripts"
        ],
        "post-update-cmd": [
            "@auto-scripts"
        ]
    }
}
